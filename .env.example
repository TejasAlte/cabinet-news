# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never expose to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI summaries — optional. If unset, a deterministic extractive fallback is used.
OPENAI_API_KEY=

# Shared secret required by /api/cron/scrape and the GitHub Action.
CRON_SECRET=
